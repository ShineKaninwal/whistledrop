# Copy to .env for local development:  cp .env.example .env
# Real environment variables always override values in this file.

# "development" or "production". Production refuses weak/default secrets.
APP_ENV=development

# Secret used to sign moderator JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to use a random key that lasts until the server restarts.
# REQUIRED (32+ characters) when APP_ENV=production.
SECRET_KEY=

# SQLite file for local development.
DATABASE_URL=sqlite:///./whistledrop.db

# How long a moderator login stays valid.
ACCESS_TOKEN_MINUTES=60

# Comma-separated browser origins allowed to call the API (only needed if the
# dashboard is hosted on a different origin than the API).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Moderator account created on startup if it does not exist yet.
# In production use a strong password (10+ characters) that is not this placeholder.
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=change-me-please

# bcrypt cost factor (12 is a sensible default).
BCRYPT_ROUNDS=12
